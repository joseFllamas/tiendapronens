# Ignore directories generated by Composer.
/drush/contrib/
/vendor/
/web/core/
/web/libraries/
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/

# Ignore files generated by the Drupal scaffold plugin.
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/.editorconfig
/.gitattributes
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/sites/example.settings.local.php
/web/sites/example.sites.php

# Ignore sensitive information and local overrides.
/web/sites/*/settings.local.php
/web/sites/*/settings.php
/web/sites/*/settings.ddev.php
/web/sites/*/services.local.yml
**/files_back/
# Ignore Drupal's file directory.
/web/sites/*/files/

# Ignore local development tooling.
/.idea/
/.vscode/
/.phpunit.cache/
/.phpunit.result.cache
/.phpstan-cache/
/phpunit.xml
/phpstan.local.neon

# macOS.
.DS_Store

# Venv del script de unificacion de imagenes
/scripts/unificacion-imagenes/.venv/
/salida_unificacion/

.ddev/
**/*.gz
.user.ini
**/node_modules   
/correosoficial/
/design/


# Ficheros privados de Drupal (facturas PDF). La ruta la fija settings.local.php.
/private/*
!/private/.gitkeep
