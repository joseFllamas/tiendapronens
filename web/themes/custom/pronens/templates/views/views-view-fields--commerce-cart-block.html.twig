{#
/**
 * @file
 * Línea del carrito en el flyout: foto, nombre, opciones, cantidad y total.
 *
 * linea (nombre, url, foto, opciones, bordado, ajustes) viene de CarritoHooks. El botón
 * de quitar es el de Commerce (commerce_order_item_remove_button), así que
 * funciona sin JS.
 */
#}
<div class="pro-line">
  <a class="pro-line__media" href="{{ linea.url }}">
    {% if linea.foto %}{{ linea.foto }}{% endif %}
  </a>
  <div class="pro-line__body">
    <p class="pro-line__name"><a href="{{ linea.url }}">{{ linea.nombre }}</a></p>
    {% if linea.opciones %}
      <p class="pro-line__meta">{{ linea.opciones }}</p>
    {% endif %}
    {% if linea.bordado %}
      <p class="pro-line__perso">{{ 'Embroidery'|t }}: {{ linea.bordado }}</p>
      {% if linea.fondo %}
        <p class="pro-line__perso">{{ 'Background'|t({}, {'context': 'Embroidery'}) }}: {{ linea.fondo }}</p>
      {% endif %}
    {% endif %}
    <div class="pro-line__row">
      <span class="pro-line__qty">{{ 'Qty.'|t }} {{ fields.quantity.content }}</span>
      <span class="pro-line__total">
        {{ fields.total_price__number.content }}
        {% for ajuste in linea.ajustes %}
          <span class="pro-line__fee">+ {{ ajuste.importe }} {{ ajuste.etiqueta|lower }}</span>
        {% endfor %}
      </span>
    </div>
  </div>
  <div class="pro-line__remove">{{ fields.remove_button.content }}</div>
</div>
