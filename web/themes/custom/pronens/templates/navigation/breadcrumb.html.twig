{#
/**
 * @file
 * Miga de pan: separadores "/" y último tramo sin enlace, como el prototipo.
 *
 * Variables:
 * - breadcrumb: tramos de la miga. El de la página actual lo añade
 *   CatalogoHooks::preprocessBreadcrumb() en la pantalla de categoría (core
 *   solo devuelve los ancestros).
 */
#}
{% if breadcrumb %}
  {{ attach_library('pronens/breadcrumb') }}
  <nav class="pro-breadcrumb" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <ol class="pro-breadcrumb__list pro-container">
      {% for item in breadcrumb %}
        <li class="pro-breadcrumb__item">
          {% if item.url %}
            <a class="pro-breadcrumb__link" href="{{ item.url }}">{{ item.text }}</a>
          {% else %}
            <span class="pro-breadcrumb__current" aria-current="page">{{ item.text }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
