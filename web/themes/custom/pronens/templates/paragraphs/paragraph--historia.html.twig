{#
/**
 * @file
 * Sección historia sobre fondo ink.
 */
#}
{{ attach_library('pronens/historia') }}
<section{{ attributes.addClass('pro-historia') }}>
  <div class="pro-historia__inner pro-container">
    <div>
      {% if content.field_eyebrow|render %}
        <p class="pro-eyebrow pro-historia__eyebrow">{{ content.field_eyebrow }}</p>
      {% endif %}
      <h2 class="pro-historia__title">{{ content.field_titulo }}</h2>
    </div>
    <div class="pro-historia__body">
      {{ content.field_texto_largo }}
      {% if enlace %}
        <a class="pro-historia__link" href="{{ enlace.url }}">{{ enlace.title }}</a>
      {% endif %}
    </div>
  </div>
</section>
