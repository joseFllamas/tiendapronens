{#
/**
 * @file
 * Sección de personalización: foto + tres pasos numerados (contador CSS).
 */
#}
{{ attach_library('pronens/pasos') }}
<section{{ attributes.addClass(['pro-pasos', pasos_blanco ? 'pro-pasos--blanco']) }}>
  <div class="pro-pasos__inner pro-container">
    {% if pasos_image %}
      <div class="pro-pasos__media">{{ pasos_image }}</div>
    {% endif %}
    <div class="pro-pasos__body">
      {% if content.field_eyebrow|render %}
        <p class="pro-eyebrow pro-pasos__eyebrow">{{ content.field_eyebrow }}</p>
      {% endif %}
      <h2 class="pro-pasos__title">
        {{ content.field_titulo }}
        {% if paragraph.field_titulo_enfasis.value %}
          <em class="pro-pasos__title-accent">{{ paragraph.field_titulo_enfasis.value }}</em>
        {% endif %}
      </h2>
      {% if content.field_texto|render %}
        <div class="pro-pasos__intro">{{ content.field_texto }}</div>
      {% endif %}
      <div class="pro-pasos__items{{ pasos_grid ? ' pro-pasos__items--grid' }}">
        {{ content.field_items }}
      </div>
      {% if enlace %}
        <a class="pro-btn pro-btn--dark pro-pasos__cta" href="{{ enlace.url }}">{{ enlace.title }}</a>
      {% endif %}
    </div>
  </div>
</section>
