{#
/**
 * @file
 * Tarjeta de producto para listados (best sellers, categoría).
 *
 * card (image, url, title, price, personalizable, cycle, opciones) viene de
 * PronensHooks::preprocessCommerceProduct(). Los chips de opciones son el eje
 * real de variación del producto (talla, medida o pieza) y llevan a la ficha
 * con la variación ya elegida.
 */
#}
{{ attach_library('pronens/card') }}
<article{{ attributes.addClass('pro-card') }}>
  <a class="pro-card__media" href="{{ card.url }}"{% if card.cycle %} data-pro-cycle="{{ card.cycle }}"{% endif %}>
    {% if card.image %}
      {{ card.image }}
    {% endif %}
  </a>
  <div class="pro-card__info">
    <div class="pro-card__row">
      <a class="pro-card__name" href="{{ card.url }}">{{ card.title }}</a>
      {% if card.price %}
        <span class="pro-card__price">{{ card.price }}</span>
      {% endif %}
    </div>
    {% if card.personalizable %}
      <div class="pro-card__note">{{ 'Embroidered in 72h'|t }}</div>
    {% endif %}
    {% if card.opciones %}
      <ul class="pro-card__opts">
        {% for opcion in card.opciones %}
          <li><a class="pro-card__opt" href="{{ opcion.url }}">{{ opcion.etiqueta }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</article>
