{#
/**
 * @file
 * Ficha de producto: galería 3:4 a la izquierda, compra a la derecha.
 *
 * ficha (eyebrow, titulo, fotos, precio, recargo_texto, personalizable,
 * guia_tallas, relacionados) viene de FichaHooks::buildFicha(). El bloque de
 * compra es el formulario de añadir al carrito de Commerce, ya reordenado y
 * con clases por FichaHooks::formAlter(): atributos, card de personalización,
 * y cantidad junto al CTA.
 *
 * La zona de valoraciones del prototipo no se pinta: hace falta un módulo de
 * reseñas que aún no está elegido (ver CLAUDE.md).
 */
#}
<article{{ attributes.addClass('pro-ficha') }}>
  <div class="pro-ficha__grid">
    <div class="pro-ficha__gallery" data-pro-galeria>
      {% for foto in ficha.fotos %}
        {# Enlace y no div: sin JS lleva a la foto grande, y con JS el propio JS
           intercepta el clic y abre el lightbox. #}
        {# La vista previa del bordado vive en la foto que diga
           field_bordado_foto (foto.bordado), no siempre en la primera: en un
           body con el dibujo delante y el nombre detrás, pintarla sobre la
           primera la pondría encima del dibujo. El JS la señala con un
           resplandor y la trae a la vista al activar el bordado. #}
        <a class="pro-ficha__shot{{ loop.first ? ' pro-ficha__shot--main' }}{{ foto.bordado ? ' pro-ficha__shot--preview' }}"
           href="{{ foto.grande }}"
           data-pro-zoom="{{ loop.index0 }}"
           data-pro-pie="{{ foto.pie }}"
           {# Píxeles reales de la foto y, si el original da para más, la
              versión de más resolución que carga la lupa al acercarla. #}
           data-pro-ancho="{{ foto.ancho }}"
           {% if foto.lupa %}data-pro-lupa="{{ foto.lupa }}"{% endif %}
           {{ foto.bordado ? 'data-pro-preview-target' : '' }}>
          {{ foto.imagen }}
          {% if foto.bordado and ficha.personalizable %}
            {# Vista previa en vivo: el JS escribe aquí lo que se teclea. #}
            {# El montaje se coloca en porcentajes del alto y del ancho de la
               foto, así que vale igual en cualquier tamaño de pantalla. En modo
               inicial el tamaño es el lado del parche y en modo nombre la altura
               de la letra, de ahí las dos variables. #}
            {# Y si el producto ofrece fondo (la nube de las mochilas y las
               bolsas), el nombre no va sobre la tela sino dentro de él: la
               nube manda el ancho y la caja de dentro es el hueco al que el
               JS encoge el nombre cuando es largo. El color del hilo del
               fondo se declara el último porque gana al del producto. #}
            {% set bordado = ficha.bordado %}
            {% set fondo = ficha.fondo %}
            <div class="pro-ficha__preview pro-ficha__preview--{{ bordado.modo == 'inicial' ? 'inicial' : 'nombre' }} pro-ficha__preview--{{ bordado.fuente }}{{ bordado.mayusculas ? ' pro-ficha__preview--caps' }}{{ fondo ? ' pro-ficha__preview--con-fondo' }}"
                 data-pro-preview hidden
                 style="--pro-inicial-x:{{ ficha.inicial.x }}%;--pro-inicial-y:{{ ficha.inicial.y }}%;--pro-inicial-tamano:{{ ficha.inicial.tamano }}%;--pro-bordado-alto:{{ ficha.inicial.tamano }};--pro-bordado-giro:{{ ficha.inicial.rotacion }}deg{% if bordado.color %};--pro-bordado-color:{{ bordado.color }}{% endif %}{% if fondo %};--pro-fondo-ancho:{{ ficha.inicial.fondo_ancho }}%;--pro-caja-ancho:{{ fondo.ancho }}%;--pro-caja-alto:{{ fondo.alto }}%{% if fondo.color %};--pro-bordado-color:{{ fondo.color }}{% endif %}{% endif %}">
              {% if fondo %}
                <img class="pro-ficha__preview-fondo" src="{{ fondo.foto }}" alt="" data-pro-preview-fondo>
              {% endif %}
              <span class="pro-ficha__preview-caja" data-pro-preview-caja>
                <span class="pro-ficha__preview-text" data-pro-preview-text></span>
              </span>
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>

    {% if ficha.fotos|length %}
      {# Lightbox: dialog nativo, así Escape y el foco los gestiona el navegador.
         Las fotos se ven enteras, sin el recorte 3:4 de la cuadrícula. #}
      <dialog class="pro-zoom" data-pro-zoom-dialog>
        <div class="pro-zoom__bar">
          <span class="pro-zoom__count" data-pro-zoom-count></span>
          {# Aviso de que la foto se puede acercar: lo escribe el JS, que es
             quien sabe si esta foto tiene píxeles de sobra y si se apunta con
             ratón o con el dedo. #}
          <span class="pro-zoom__hint" data-pro-zoom-hint hidden></span>
          <button type="button" class="pro-zoom__close" data-pro-zoom-close aria-label="{{ 'Close'|t }}">✕</button>
        </div>
        <figure class="pro-zoom__figure">
          {# El lienzo recorta lo que se sale al acercar la foto. #}
          <div class="pro-zoom__lienzo" data-pro-zoom-lienzo>
            <img data-pro-zoom-img alt="">
          </div>
          <figcaption class="pro-zoom__caption" data-pro-zoom-caption></figcaption>
        </figure>
        {% if ficha.fotos|length > 1 %}
          <button type="button" class="pro-zoom__nav pro-zoom__nav--prev" data-pro-zoom-prev aria-label="{{ 'Previous image'|t }}">‹</button>
          <button type="button" class="pro-zoom__nav pro-zoom__nav--next" data-pro-zoom-next aria-label="{{ 'Next image'|t }}">›</button>
        {% endif %}
      </dialog>
    {% endif %}

    <div class="pro-ficha__buy">
      {% if ficha.eyebrow %}
        <p class="pro-eyebrow">{{ ficha.eyebrow }}</p>
      {% endif %}
      <h1 class="pro-ficha__title">{{ ficha.titulo }}</h1>

      <div class="pro-ficha__prices">
        <span class="pro-ficha__price" data-pro-total>{{ ficha.precio }}</span>
        {% if ficha.recargo_texto %}
          <span class="pro-ficha__breakdown" data-pro-breakdown hidden>
            {{ ficha.precio }} + {{ ficha.recargo_texto }} {{ 'embroidery'|t }}
          </span>
        {% endif %}
      </div>

      {{ product.variations }}

      {% if ficha.guia_bordado %}
        {# Diálogo nativo: sin librerías, cierra con Escape y atrapa el foco él
           solo. El enlace que lo abre lo añade ficha.js junto al selector de
           formato, que es donde hace falta la ayuda. #}
        <dialog class="pro-guia" id="pro-guia-bordado" data-pro-guia>
          <div class="pro-guia__head">
            <h2 class="pro-guia__title">{{ 'How the embroidery looks'|t }}</h2>
            <button type="button" class="pro-guia__close" data-pro-guia-close aria-label="{{ 'Close'|t }}">✕</button>
          </div>
          <div class="pro-guia__body">{{ ficha.guia_bordado }}</div>
        </dialog>
      {% endif %}

      <ul class="pro-ficha__trust">
        <li>{{ 'Free shipping over €60'|t }}</li>
        <li>{{ 'Embroidered in 72h'|t }}</li>
        <li>{{ 'Returns within 30 days'|t }}</li>
      </ul>

      {# Plegada: las descripciones migradas son largas y empujaban el resto
         de la columna de compra fuera de pantalla (decisión 2026-08-11). #}
      {% if product.body|render|trim %}
        <details class="pro-acc">
          <summary class="pro-acc__title">{{ 'Description'|t }}</summary>
          <div class="pro-acc__body">{{ product.body }}</div>
        </details>
      {% endif %}
      {% if product.field_lavado|render|trim %}
        <details class="pro-acc">
          <summary class="pro-acc__title">{{ 'Care and washing'|t }}</summary>
          <div class="pro-acc__body">{{ product.field_lavado }}</div>
        </details>
      {% endif %}
      {% if ficha.guia_tallas %}
        <details class="pro-acc" id="guia-tallas">
          <summary class="pro-acc__title">{{ 'Size guide'|t }}</summary>
          <div class="pro-acc__body">{{ ficha.guia_tallas.contenido }}</div>
        </details>
      {% endif %}
      <details class="pro-acc pro-acc--last">
        <summary class="pro-acc__title">{{ 'Shipping and returns'|t }}</summary>
        <div class="pro-acc__body">
          <p>{{ 'Free shipping in mainland Spain on orders over €60. We also ship to the Balearic and Canary Islands, Portugal and the rest of the EU. Returns within 30 days for items without embroidery.'|t }}</p>
        </div>
      </details>
    </div>
  </div>

  {# Los complementarios (field_complementarios) NO se enseñan aquí: salen en
     el flyout del carrito como "Completa el conjunto", que es donde la
     referencia los pone y donde de verdad convierten. #}

  {# Similares: alternativas de la misma categoría, automáticos. #}
  {% if ficha.relacionados %}
    <section class="pro-ficha__related">
      <h2 class="pro-ficha__related-title">{{ 'You may also like'|t }}</h2>
      <div class="pro-grid" data-pro-cols="4">
        {% for tarjeta in ficha.relacionados %}
          <div class="pro-grid__cell">{{ tarjeta }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>
