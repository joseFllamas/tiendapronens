{#
/**
 * @file
 * Layout de página del tema Pronens.
 *
 * Full-width sin sidebars: cada componente acota su contenido con
 * .pro-container. Las páginas genéricas (CMS, checkout…) usan el
 * modificador --boxed que aplica el contenedor central.
 *
 * @see html.html.twig
 */
#}
{{ attach_library('pronens/marquee') }}
{{ attach_library('pronens/header') }}
{{ attach_library('pronens/footer') }}
<div class="pro-page">

  {{ page.marquee }}

  <header class="pro-header" data-pro-header>
    <div class="pro-header__inner pro-container">
      <button class="pro-header__burger" type="button" data-pro-burger
              aria-expanded="false" aria-controls="pro-nav"
              aria-label="{{ 'Open menu'|t }}">
        <span class="pro-header__burger-bar"></span>
        <span class="pro-header__burger-bar"></span>
        <span class="pro-header__burger-bar"></span>
      </button>
      <div class="pro-header__nav" id="pro-nav" data-pro-nav>
        {{ page.primary_menu }}
      </div>
      <div class="pro-header__brand">
        {{ page.header }}
      </div>
      <div class="pro-header__actions">
        <a class="pro-header__icon pro-header__icon--search" href="{{ path('<front>') }}buscar" aria-label="{{ 'Search'|t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
        </a>
        <a class="pro-header__icon pro-header__icon--account" href="{{ path('user.page') }}" aria-label="{{ 'My account'|t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
        </a>
        {{ page.header_actions }}
      </div>
    </div>
  </header>

  {{ page.breadcrumb }}

  {{ page.highlighted }}

  {{ page.help }}

  <main class="pro-page__main{{ main_boxed ? ' pro-page__main--boxed' }}">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {% if cuenta %}
      {# Área de cliente: navegación lateral común a resumen, pedidos,
         direcciones y datos (CuentaHooks::buildShell). #}
      <div class="pro-cuenta">
        <aside class="pro-cuenta__aside">
          <nav class="pro-cuenta__nav" aria-label="{{ 'My account'|t }}">
            <ul class="pro-cuenta__menu">
              {% for item in cuenta.nav %}
                <li class="pro-cuenta__item">
                  <a class="pro-cuenta__link{{ item.activa ? ' is-active' }}"
                     href="{{ item.url }}"{% if item.activa %} aria-current="page"{% endif %}>{{ item.etiqueta }}</a>
                </li>
              {% endfor %}
            </ul>
            <a class="pro-cuenta__salir" href="{{ cuenta.salir }}">{{ 'Log out'|t }}</a>
          </nav>
        </aside>
        <div class="pro-cuenta__content">
          {{ page.content }}
        </div>
      </div>
    {% else %}
      {{ page.content }}
    {% endif %}
  </main>

  <footer class="pro-footer">
    <div class="pro-footer__grid pro-container">
      {{ page.footer }}
    </div>
    <div class="pro-footer__legal">
      <div class="pro-footer__legal-inner pro-container">
        <span class="pro-footer__copyright">© {{ 'now'|date('Y') }} Pronens. {{ 'All rights reserved.'|t }}</span>
        {{ page.footer_legal }}
      </div>
    </div>
  </footer>

</div>
