parameters:
  # High level. Drupal's loose typing makes 9/10 impractical without a large
  # baseline, so 8 is the strictest level that stays useful here.
  level: 8

  paths:
    - web/modules/custom
    - web/themes/custom

  drupal:
    # Stricter than the extension defaults: we write config schema for the
    # custom module, so let PHPStan type config:get() and flag unknown keys.
    configGetReturnType: true
    rules:
      configGetUnknownKeyRule: true
      pluginManagerInspectionRule: true

  excludePaths:
    analyseAndScan:
      - web/modules/custom/*/tests/fixtures/*

  # Treat PHP notices/warnings raised during analysis as errors.
  reportUnmatchedIgnoredErrors: true

  ignoreErrors:
    # commerce_stock tipa $unit_cost como float en el docblock de
    # StockTransactionsInterface::receiveStock(), pero la columna de base de
    # datos admite NULL y el D7 no guardaba coste de compra. Pasar 0.0 sería
    # afirmar que el coste es cero, que es peor que declararlo desconocido.
    -
      message: '#Parameter \#5 \$unit_cost of method .+::receiveStock\(\) expects float, null given\.#'
      path: web/modules/custom/pronens_migrate/src/EventSubscriber/StockTransactionSubscriber.php

    # Fricción conocida entre los arrays de formulario sin tipar de Drupal y el
    # nivel 8: si se anota el $form por referencia, PHPStan exige que el tipo
    # coincida exactamente con el del padre, que no lo declara. Anotarlo y no
    # anotarlo dan error, así que se silencia solo para métodos de formulario.
    -
      identifier: parameterByRef.type
      path: web/modules/custom/*/src/Form/*.php
